# HTTP server
PORT=8080
CORS_ORIGIN=http://localhost:5173,https://maismorras.vercel.app

# Pollinations image proxy
POLLINATIONS_BASE_URL=https://image.pollinations.ai
# Optional: enables on-demand, explicitly marked AI translations in the compendium.
# Create a backend-only sk_ key at https://enter.pollinations.ai. Never expose it to the frontend.
POLLINATIONS_TEXT_URL=https://gen.pollinations.ai/v1/chat/completions
POLLINATIONS_API_KEY=sk_replace-with-your-pollinations-secret-key
TRANSLATION_MODEL=openai-fast

# Recommended low/no-cost providers. When configured, these take priority over Pollinations.
# DeepL API Free: create an API key in your DeepL account; never expose it to the frontend.
DEEPL_API_KEY=
DEEPL_TRANSLATE_URL=https://api-free.deepl.com/v2/translate
# Cloudflare Dashboard → Workers AI → Use REST API; token should have Workers AI Read/Write only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
UPSTREAM_TIMEOUT=20s
MAX_IMAGE_BYTES=5242880

# Supabase / PostgreSQL
# Use the Session Pooler connection string from Supabase Dashboard → Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional legacy HS256 secret. New Supabase projects using ES256 signing keys
# should leave this empty; the backend validates through SUPABASE_URL/.well-known/jwks.json.
# Never expose this value to the frontend or commit a real secret.
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
